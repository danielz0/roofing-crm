# Copy to .env (repo root). Read by the API dev server (tsx --env-file) and by Vite (VITE_* only).
# Every variable is optional unless marked REQUIRED; defaults are shown.

# ---------------------------------------------------------------- Data snapshot (read-only, never ingested)
# REQUIRED in AWS. Pipeline export root: a local directory (absolute, or relative to this repo root) or an
# https URL such as an IPFS gateway directory: https://ipfs.io/ipfs/<rootCid>
# A local path may also point at the pipeline's exports/ directory; the latest run directory is used.
# Local dev default when unset: ../oracle-property-intelligence-platform-pipeline-travis-tx/data/exports
CRM_DATA_BASE_URL=../oracle-property-intelligence-platform-pipeline-travis-tx/data/exports
# materialize = load property_leads into in-memory DuckDB at startup (fast queries); view = query parquet in place
CRM_DATA_MODE=materialize
# DuckDB tuning (optional)
# CRM_DUCKDB_MEMORY_LIMIT=4GB
# CRM_DUCKDB_THREADS=4
# Directory holding pre-downloaded DuckDB extensions (Lambda sets /var/task/duckdb_extensions)
# CRM_DUCKDB_EXTENSION_DIR=
# true = never INSTALL extensions from extensions.duckdb.org at runtime
CRM_DUCKDB_OFFLINE=false

# ---------------------------------------------------------------- County + lead defaults
CRM_COUNTY_NAME=Travis County
CRM_COUNTY_STATE=TX
CRM_COUNTY_FIPS=48453
# Default map/search center (downtown Austin)
CRM_DEFAULT_CENTER_LAT=30.2672
CRM_DEFAULT_CENTER_LNG=-97.7431
CRM_DEFAULT_RADIUS_MILES=3
CRM_ROOF_AGE_THRESHOLD_YEARS=15
# Open roofing permits at least this old are "long-open" (highlighted red, high priority)
CRM_LONG_OPEN_PERMIT_DAYS=365

# ---------------------------------------------------------------- CRM leads persistence
# memory | file | dynamodb   (AWS uses dynamodb; local dev defaults to a JSON file)
CRM_LEADS_STORE=file
# Relative to apps/api
CRM_LEADS_FILE=.data/leads.json
# Required when CRM_LEADS_STORE=dynamodb
# CRM_LEADS_TABLE=

# ---------------------------------------------------------------- API server (local)
CRM_API_PORT=4000
CRM_CORS_ORIGIN=*

# ---------------------------------------------------------------- Agent / LLM (Vercel AI SDK)
# bedrock | anthropic | openai | none   (none = deterministic retrieval-only answers, no LLM)
# Bedrock uses the AWS credential provider chain (AWS_PROFILE / SSO locally, the Lambda role in AWS).
LLM_PROVIDER=bedrock
# Defaults: bedrock=us.anthropic.claude-opus-5-5 (inference profile; must be enabled in the account),
#           anthropic=claude-opus-5-5, openai=gpt-5-mini
# LLM_MODEL_ID=
LLM_REGION=us-east-2
LLM_MAX_STEPS=8
# Whole agent loop timeout; on timeout/error the API falls back to retrieval-only answers
LLM_TIMEOUT_MS=25000
# Optional semantic re-rank of BM25 permit hits: none | bedrock-titan
CRM_EMBEDDINGS=none
CRM_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Provider keys (only for LLM_PROVIDER=anthropic / openai)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AWS credentials for Bedrock locally (standard AWS SDK variables)
# AWS_PROFILE=

# ---------------------------------------------------------------- Observability (Powertools)
# POWERTOOLS_SERVICE_NAME=roofing-crm-api
# POWERTOOLS_METRICS_NAMESPACE=RoofingCrm
# POWERTOOLS_LOG_LEVEL=INFO
# POWERTOOLS_DEV=true

# ---------------------------------------------------------------- Web (Vite, build time)
# API base URL used when /config.json has no apiUrl (local dev). Deployed builds get config.json from CDK.
VITE_API_URL=http://localhost:4000
# MapLibre style URL (default: OpenFreeMap "liberty", free and key-less)
# VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---------------------------------------------------------------- Smoke test script (apps/api/scripts/smoke.ts)
# CRM_SMOKE_API_URL=http://localhost:4000
# CRM_SMOKE_PLACE=Pflugerville
