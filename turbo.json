{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CRM_*", "LLM_*", "AWS_REGION", "VITE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "synth": {
      "dependsOn": ["@roofing-crm/web#build"],
      "cache": false
    }
  }
}
